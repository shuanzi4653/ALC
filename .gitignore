# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Java / Maven build output
backend-java/target/
*.class
*.jar
*.war

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
backend-java/src/main/resources/static/
*.tsbuildinfo

# Python virtual environments and caches
backend-python/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Runtime data and logs
data/*.db
data/*.trace.db
data/*.mv.db
*.log

# Local backups (never distribute)
backup/
backups/
data_backup_*/

# Local audit and temporary artifacts
.audit/
.run/
*.tmp
*.temp

# Local secrets and machine-specific configuration
config/application.yml
backend-java/src/main/resources/application.yml
config/qweather/*.pem
*.key
*.secret

# Encrypted credential store: ciphertext only, but it must never be distributed.
backend-python/data/secrets.db
backend-python/data/secrets.db-journal
backend-python/data/secrets.db-wal

# External site credentials (plaintext password inside — never distribute)
SHUANZI_SITE_CREDENTIALS.md

# 部署用的 Python 打包产物（由 tools/deploy/_deploy_release.py 现场生成）
py-*.tar.gz

# 调试产物与工具缓存（体积大、可再生成）
artifacts/
.playwright-cli/
.workbuddy/

# 打包副本与已退役代码
TianChuang.zip
backend-python/simulator.py.retired

# 误创建的空文件（文件名本身是说明文字）
本目录索引*

# 训练原始数据（42 MB，可由脚本重新下载）
# 只忽略 csv 原始序列，指标与清单 json 必须入库 —— 它们是材料数字的唯一依据
data/training/metar/*.csv
data/training/metar/raw/
data/training/annotate-cache/
data/training/raw/
