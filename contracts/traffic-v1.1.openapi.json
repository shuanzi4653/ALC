{
  "openapi": "3.1.0",
  "info": {
    "title": "Northeast Traffic Simulation",
    "version": "1.1.0"
  },
  "paths": {
    "/traffic/network": {
      "get": {
        "summary": "Traffic Network",
        "operationId": "traffic_network_traffic_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/traffic/session": {
      "get": {
        "summary": "Traffic Session",
        "operationId": "traffic_session_traffic_session_get",
        "parameters": [
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 99999,
              "minimum": 0,
              "default": 42,
              "title": "Seed"
            }
          },
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(clear|moving|unknown)$",
              "default": "moving",
              "title": "Scenario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/weather": {
      "get": {
        "summary": "Traffic Weather",
        "operationId": "traffic_weather_traffic_weather_get",
        "parameters": [
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 99999,
              "minimum": 0,
              "default": 42,
              "title": "Seed"
            }
          },
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(clear|moving|unknown)$",
              "default": "moving",
              "title": "Scenario"
            }
          },
          {
            "name": "minute",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 480,
              "minimum": 0,
              "default": 30,
              "title": "Minute"
            }
          },
          {
            "name": "cityId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cityid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "context": {
            "type": "string",
            "title": "Context",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "EvaluateRequest": {
        "properties": {
          "scenario": {
            "type": "string",
            "title": "Scenario",
            "default": "crossing"
          },
          "seed": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          },
          "origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin"
          },
          "uncertainty": {
            "type": "boolean",
            "title": "Uncertainty",
            "default": true
          },
          "task": {
            "$ref": "#/components/schemas/TaskSpec"
          }
        },
        "type": "object",
        "required": [
          "task"
        ],
        "title": "EvaluateRequest"
      },
      "EvidenceQuestion": {
        "properties": {
          "decisionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Decisionid"
          },
          "question": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "decisionId",
          "question"
        ],
        "title": "EvidenceQuestion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TaskSpec": {
        "properties": {
          "regionId": {
            "type": "string",
            "title": "Regionid"
          },
          "from": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "From"
          },
          "to": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "To"
          },
          "speedKmh": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Speedkmh"
          },
          "enduranceMinutes": {
            "type": "number",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Enduranceminutes"
          },
          "departureMinute": {
            "type": "number",
            "maximum": 1260.0,
            "minimum": 0.0,
            "title": "Departureminute",
            "default": 0
          },
          "latestArrivalMinute": {
            "type": "number",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Latestarrivalminute",
            "default": 180
          },
          "workMinutes": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Workminutes",
            "default": 0
          },
          "bufferM": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "Bufferm",
            "default": 500
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "regionId",
          "from",
          "to",
          "speedKmh",
          "enduranceMinutes"
        ],
        "title": "TaskSpec"
      },
      "Track2Request": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id",
            "default": ""
          },
          "deadline_epoch_ms": {
            "type": "integer",
            "title": "Deadline Epoch Ms",
            "default": 0
          },
          "snapshot": {
            "additionalProperties": true,
            "type": "object",
            "title": "Snapshot",
            "description": "实时观测（和风 v1 字段结构）"
          },
          "forecast": {
            "items": {},
            "type": "array",
            "title": "Forecast",
            "description": "未来逐时预报列表"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "default": "演示作业区"
          },
          "task_type": {
            "type": "string",
            "title": "Task Type",
            "default": "巡检"
          }
        },
        "type": "object",
        "required": [
          "snapshot"
        ],
        "title": "Track2Request"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}