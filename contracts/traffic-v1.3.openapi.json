{
  "openapi": "3.1.0",
  "info": {
    "title": "东北低空交通运行 API",
    "version": "1.3.0",
    "description": "V1.3 交通运行合同：时间字段分离、已声明高度层、起降与交叉资源日历、配送订单与载具状态。交通数据为模拟生成；气象为公开来源估算或合成场景，两者在响应中分别标注。"
  },
  "paths": {
    "/traffic/command": {
      "post": {
        "summary": "Traffic Command",
        "operationId": "traffic_command_traffic_command_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrafficAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/explain": {
      "post": {
        "summary": "Traffic Explain",
        "operationId": "traffic_explain_traffic_explain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrafficQuestion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/operations": {
      "get": {
        "summary": "Traffic Operation History",
        "operationId": "traffic_operation_history_traffic_operations_get",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$",
              "title": "Sessionid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/network": {
      "get": {
        "summary": "Traffic Network",
        "operationId": "traffic_network_traffic_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/traffic/plan": {
      "get": {
        "summary": "Traffic Plan",
        "operationId": "traffic_plan_traffic_plan_get",
        "parameters": [
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 99999,
              "minimum": 0,
              "default": 42,
              "title": "Seed"
            }
          },
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(clear|moving|unknown|live)$",
              "default": "moving",
              "title": "Scenario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/hubs": {
      "get": {
        "summary": "Traffic Hubs",
        "operationId": "traffic_hubs_traffic_hubs_get",
        "parameters": [
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 99999,
              "minimum": 0,
              "default": 42,
              "title": "Seed"
            }
          },
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(clear|moving|unknown|live)$",
              "default": "moving",
              "title": "Scenario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/delivery": {
      "get": {
        "summary": "Traffic Delivery",
        "operationId": "traffic_delivery_traffic_delivery_get",
        "parameters": [
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 99999,
              "minimum": 0,
              "default": 42,
              "title": "Seed"
            }
          },
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(clear|moving|unknown|live)$",
              "default": "moving",
              "title": "Scenario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/session": {
      "get": {
        "summary": "Traffic Session",
        "operationId": "traffic_session_traffic_session_get",
        "parameters": [
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 99999,
              "minimum": 0,
              "default": 42,
              "title": "Seed"
            }
          },
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(clear|moving|unknown|live)$",
              "default": "moving",
              "title": "Scenario"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traffic/weather": {
      "get": {
        "summary": "Traffic Weather",
        "operationId": "traffic_weather_traffic_weather_get",
        "parameters": [
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 99999,
              "minimum": 0,
              "default": 42,
              "title": "Seed"
            }
          },
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(clear|moving|unknown|live)$",
              "default": "moving",
              "title": "Scenario"
            }
          },
          {
            "name": "minute",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 480,
              "minimum": 0,
              "default": 30,
              "title": "Minute"
            }
          },
          {
            "name": "cityId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cityid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TrafficAction": {
        "properties": {
          "seed": {
            "type": "integer",
            "maximum": 99999.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          },
          "scenario": {
            "type": "string",
            "pattern": "^(clear|moving|unknown|live)$",
            "title": "Scenario",
            "default": "moving"
          },
          "flightId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Flightid"
          },
          "minute": {
            "type": "number",
            "maximum": 480.0,
            "minimum": 0.0,
            "title": "Minute"
          },
          "action": {
            "type": "string",
            "pattern": "^(SUSPEND|RESUME)$",
            "title": "Action"
          },
          "planRevision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Planrevision"
          },
          "commandId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Commandid"
          }
        },
        "type": "object",
        "required": [
          "flightId",
          "minute",
          "action"
        ],
        "title": "TrafficAction"
      },
      "TrafficQuestion": {
        "properties": {
          "seed": {
            "type": "integer",
            "maximum": 99999.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          },
          "scenario": {
            "type": "string",
            "pattern": "^(clear|moving|unknown|live)$",
            "title": "Scenario",
            "default": "moving"
          },
          "flightId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Flightid"
          },
          "minute": {
            "type": "number",
            "maximum": 480.0,
            "minimum": 0.0,
            "title": "Minute"
          },
          "question": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "minute",
          "question"
        ],
        "title": "TrafficQuestion"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
